[Unit]
Description=Interactive RNA-seq viewer (read-only Dash app)
After=network.target
# Soft dependency: start even if nginx unit name differs on this host.
Wants=nginx.service

[Service]
Type=simple
User=lab
Group=lab
WorkingDirectory=/home/lab/Interactive_RNASeq_ana
Environment=PYTHONPATH=/home/lab/Interactive_RNASeq_ana
Environment=DASH_READONLY=1
Environment=DASH_URL_BASE_PATHNAME=/interactive/
Environment=DASH_DEFAULT_PROJECT=/home/lab/data/Johannes/biofilm-microenvironments2
# Prefer the shared dashboard secret; override if your file name differs.
Environment=DASH_SECRET_CONFIG=/home/lab/www/dashboard/secret-rna-seq-ana.toml
# Single safe entry — never python -m src.GUI.app on this host.
ExecStart=/home/lab/anaconda3/envs/plotly/bin/gunicorn --log-level=info --timeout 900 --workers 2 src.GUI.wsgi:server -b 127.0.0.1:8052
Restart=on-failure
RestartSec=3

# Extra hardening: no writable escape via env inherited from the shell.
Environment=DASH_WRITABLE=

[Install]
WantedBy=multi-user.target
